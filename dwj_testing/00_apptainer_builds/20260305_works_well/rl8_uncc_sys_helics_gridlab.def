Bootstrap: localimage
From: rl8_uncc_sys_helics.sif

%environment
    export PATH=/usr/local/gridlabd/bin:$PATH
    export GLD_PATH=/usr/local/gridlabd/lib

%post
    # Install GridLab-D
    cd ~/develop
    dnf install -y \
	 xerces-c-devel \
    	 hdf5-devel \
	 curl \
	 ncurses-devel \
     emacs

    export MPI_HOME=/usr/local/openmpi-4.1.6
    export CC=$MPI_HOME/bin/mpicc
    export CXX=$MPI_HOME/bin/mpicxx

    git clone https://github.com/gridlab-d/gridlab-d.git gridlabd
    cd gridlabd
    git checkout -b v5.3.0 tags/v5.3.0
    git submodule update --init --recursive

    #cmake \
    #-DCMAKE_INSTALL_PREFIX=/usr/local/gridlabd \
    #-DGLD_USE_HELICS=ON \
    #-DGLD_HELICS_DIR=/usr/local/helics \
    #-DCMAKE_PREFIX_PATH=/usr/local/helics \
    #-B build

    cmake \
    -DCMAKE_INSTALL_PREFIX=/usr/local/gridlabd \
    -DGLD_USE_HELICS=ON \
    -DGLD_HELICS_DIR=/usr/local/helics \
    -DCMAKE_CXX_FLAGS="-DGLD_USE_HELICS" \
    -B build

    cd build
    make -j12 && make install

    # Clean up
    dnf clean all

%labels
    Author Alex Johnson
    Version 1.0
    Description Rocky Linux 8 Base Image

%runscript
    echo "Welcome to your Rocky Linux 8 container"
    exec /bin/bash
