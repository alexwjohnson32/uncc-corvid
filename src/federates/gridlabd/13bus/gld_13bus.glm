#set profiler=1
#set iteration_limit=100000;
#set relax_naming_rules=1;
#set minimum_timestep=15;

module powerflow {
    solver_method NR;
};

module tape;
module connection;

// Define transmission line parameters
object overhead_line {
    name line_1_2;
//    from Node1;
    from Meter1;
    to Node2;
    phases ABC;
    length 5280;
    configuration "line_config";
};

object overhead_line {
    name line_2_3;
    from Node2;
    to Node3;
    phases ABC;
    length 5280;
