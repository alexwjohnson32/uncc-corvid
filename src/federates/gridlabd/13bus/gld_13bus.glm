// Create load objects

object load {
     name Load1;
     parent Node3;
     phases "ABCN";
     voltage_A 2401.7771;
     voltage_B -1200.8886-2080.000j;
     voltage_C -1200.8886+2080.000j;
     constant_power_A 16000+11000j;
     constant_power_B 12000-9000j;
     constant_power_C 10000+8000j;
     nominal_voltage 2401.7771;
}

