     filename Volt_Dump_NR_cosim.csv;
}
object currdump {
     filename Current_Dump_NR_cosim.csv;
}

module tape;

object recorder {
    parent Meter1;
    property voltage_A.real,voltage_A.imag,voltage_B.real,voltage_B.imag,voltage_C.real,voltage_C.imag;
    file Meter1_voltage_glm.csv;
    interval 900;
}

